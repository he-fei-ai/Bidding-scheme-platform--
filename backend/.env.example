# AI 服务配置
# 复制此文件为 .env 后配置 API 密钥，不要提交到版本控制

# 通用 AI 配置（优先级最高，会覆盖下方专用配置）
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o

# DeepSeek 专用配置
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI 专用配置
OPENAI_API_KEY=your_openai_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ── 内置默认厂商 agnes（文本模型配置模块的兜底厂商）────────────────────
# 未配置时平台仍可运行（前端「文本模型配置」页可自行录入任意厂商），
# 但降级链最后一层（内置兜底）与「一键配置」的默认指向会失效。
# AGNES_API_KEY=
# AGNES_BASE_URL=https://api.agnes-ai.cn/v1
# AGNES_MODEL=agnes-2.0-flash

# ── 文本模型配置模块：密钥加密主密钥 ─────────────────────────────────
# 未设置时自动生成到 backend/.secret_key（chmod 600）。
# ⚠️ 多实例/多进程部署**必须**显式共享同一密钥（推荐用文件挂载），
#    否则各进程各自生成、解密彼此的 ENC: 密文失败 → AI 调用 401。
# BID_ASSISTANT_KEY=<base64 32 字节>
# BID_ASSISTANT_KEY_FILE=/run/secrets/bid_assistant_key

# ── 文本模型配置模块：安全与限流开关 ─────────────────────────────────
# 是否允许把 AI base_url 指向内网/环回/云元数据地址。
# 生产环境若无内网自建模型需求，设为 false 以启用 SSRF 防护。
# AI_ALLOW_INTERNAL_URL=true

# 文本模型配置的「测试连接」探针并发上限（默认 5，超出排队 30s 后返回 429）
# AI_TEST_CONCURRENCY_LIMIT=5

# AI 调用全局并发上限（默认 5）
# AGNES_MAX_CONCURRENCY=5

# AI 调用限流闸门：默认 RPM（默认 60，0=不限流）/ 默认并发（默认 5）
# AI_RATE_LIMIT_RPM=60
# AI_RATE_LIMIT_CONCURRENCY=5

# 命中 429 时的独立重试预算与退避（默认 6 次 / 3s 起 / 上限 60s）
# AI_RATE_LIMIT_RETRIES=6
# AI_RATE_LIMIT_BASE_WAIT=3
# AI_RATE_LIMIT_MAX_WAIT=60

# ── HTTP 代理（AI 出站调用走此配置）────────────────────────────────
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# 服务配置（可选，以下为默认值）
BID_ASSISTANT_HOST=127.0.0.1
BID_ASSISTANT_PORT=5174

# 数据目录（可选，默认在项目根目录 data/ 下）
# BID_ASSISTANT_DATA_DIR=/path/to/data

# ============================================
# Redis 缓存配置
# ============================================
# Redis 连接 URL（默认本地 6379 端口，db 0 用于应用缓存，db 1 用于 Celery broker，db 2 用于 Celery backend）
REDIS_URL=redis://localhost:6379/0

# Redis 缓存默认过期时间（秒），默认 3600（1小时）
REDIS_DEFAULT_EXPIRE=3600

# ============================================
# Celery 异步任务队列配置
# ============================================
# Celery Broker URL（消息队列），默认使用 Redis db 1
CELERY_CONFIG=redis://localhost:6379/1

# Celery Result Backend（结果存储），默认使用 Redis db 2
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Celery Worker 并发数（默认 4）
CELERY_WORKER_CONCURRENCY=4

# Celery Worker 每个进程最大任务数（默认 100，达到后自动重启防止内存泄漏）
CELERY_MAX_TASKS_PER_CHILD=100

# ============================================
# 认证与安全配置
# ============================================
# 是否启用 JWT 认证（默认 false = 开发免登录；生产必须设为 true）
AUTH_ENABLED=false
# Token 有效期（分钟），默认 720
AUTH_TOKEN_EXPIRE_MINUTES=720
# 首次启动创建的 admin 初始密码（默认 admin123 为弱密码，生产请务必修改）
AUTH_INITIAL_PASSWORD=admin123
# 运行环境：development / production。
# 设为 production 且 AUTH_ENABLED=false 时，服务将拒绝启动（纵深防御）。
ENVIRONMENT=development

# ============================================
# 全局事实增强开关（facts-ns 2026-10-14，对齐易标两阶段事实消费思路）
# 以下开关默认全部关闭 = 行为与历史版本完全一致，按需逐项开启。
# ============================================
# P0：编排阶段让 AI 从事实标题清单选章节相关事实（facts.titles），
# 生成阶段按标题取全文注入（替代关键词打分筛选）。
# FACTS_ORCHESTRATED_SELECT_ENABLED=0

# P1-1：超长招标文档按 token 预算分段提取全局事实、跨段归并，
# 消除单次调用被静默截断导致后文事实丢失。
# FACTS_SEGMENTED_EXTRACTION_ENABLED=0
# 分段提取的单段 token 上限（默认 20000）。
# FACTS_SEGMENT_TOKEN_CAP=20000

# P1-2：目录标题树作为事实提取的覆盖范围参考输入（只约束分组，不是取值来源）。
# FACTS_OUTLINE_INPUT_ENABLED=0

# P1-3：omit/placeholder 缺值策略下，正文生成 system 追加「缺值口径铁律」
# 完整性指令（fabricate 策略不追加）。
# FACTS_COMPLETENESS_INSTRUCTION_ENABLED=0

# P1-4：一致性 AI 补丁修复时，被拒补丁按小节回喂重试的最大轮数
#（默认 1 = 不重试，与历史行为一致；合法范围 1~5）。
# CONSISTENCY_REPAIR_MAX_ATTEMPTS=1
